# Edge Desk — Somnia Shannon testnet (chain 50312)
# Copy to .env and fill in. Never commit .env.

# Hex private key with 0x prefix. Fund with tUSDC + STT from faucet:
# https://t.me/+XHq0F0JXMyhmMzM0
PRIVATE_KEY=

# testnet | mainnet
NETWORK=testnet

# When true, agent computes edge and reasons but does not send orders
DRY_RUN=true

# Minimum |edge| to trade (probability units, e.g. 0.05 = 5%)
EDGE_THRESHOLD=0.05

# Contract size for agent and Copy button (human units)
COPY_SIZE=1

# Venue id (testnet default below — re-read from a live market if empty list)
VENUE_ID=0x679795a0195a1b76cdebb7c51d74e058aee92919b8c3389af86ef24535e8a28c

# Optional overrides (SDK defaults are used when unset)
# INDEXER_URL=https://dev.smk.somnia.host/v1/graphql
# WS_RPC_URL=wss://api.infra.testnet.somnia.network/ws
# HTTP_RPC_URL=https://api.infra.testnet.somnia.network

# Preferred asset / window for the desk
PREFERRED_ASSET=BTC
PREFERRED_INTERVAL_SEC=900

# Agent tick interval (ms)
AGENT_INTERVAL_MS=8000
